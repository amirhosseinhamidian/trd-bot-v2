+        "dataset_id": dataset_id,
+        "fast_period": 2,
+        "slow_period": 3,
+        "horizon_candles": 1,
+        "train_candles": 4,
+        "test_candles": 2,
+        "step_candles": 2,
+        "gap_candles": 0,
+        "mode": "rolling",

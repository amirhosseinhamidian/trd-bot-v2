TRD_BOT_APP_NAME=TRD BOT v2
TRD_BOT_APP_VERSION=0.3.1
TRD_BOT_ENVIRONMENT=development
TRD_BOT_DEBUG=false

TRD_BOT_DATABASE_URL=postgresql+psycopg://trd_bot:trd_bot_dev_password@127.0.0.1:5432/trd_bot
TRD_BOT_TEST_DATABASE_URL=postgresql+psycopg://trd_bot:trd_bot_dev_password@127.0.0.1:5432/trd_bot_test

# Nexora service authentication is disabled until this points to an absolute private file.
# TRD_BOT_NEXORA_SERVICE_TOKEN_FILE=/absolute/private/path/nexora-service-token

TRD_BOT_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

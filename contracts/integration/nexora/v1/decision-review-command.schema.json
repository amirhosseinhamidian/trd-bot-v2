{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/contracts/integration/nexora/v1/decision-review-command.schema.json",
  "title": "Nexora decision review command and receipt",
  "$defs": {
    "utc_timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "nexora-source-reference-v1"},
        "source_product": {"const": "trd_bot"},
        "source_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "resource_type": {"const": "decision_evaluation"},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "resource_schema_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "observed_at": {"$ref": "#/$defs/utc_timestamp"},
        "checksum": {"$ref": "#/$defs/checksum"}
      },
      "required": [
        "schema_version", "source_product", "source_version", "resource_type", "resource_id",
        "resource_schema_version", "observed_at", "checksum"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "nexora-decision-review-command-v1"},
        "command_type": {
          "enum": [
            "decision_review.accept.v1",
            "decision_review.reject.v1",
            "decision_review.defer.v1"
          ]
        },
        "decision_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "portfolio_mode": {"enum": ["paper", "shadow"]},
        "reviewed_at": {"$ref": "#/$defs/utc_timestamp"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence": {"$ref": "#/$defs/source_reference"}
      },
      "required": [
        "schema_version", "command_type", "decision_id", "portfolio_mode", "reviewed_at",
        "reason", "evidence"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "nexora-command-receipt-v1"},
        "command_id": {"type": "string", "pattern": "^cmd_review_[0-9a-f]{32}$"},
        "command_type": {
          "enum": [
            "decision_review.accept.v1",
            "decision_review.reject.v1",
            "decision_review.defer.v1"
          ]
        },
        "status": {"enum": ["accepted", "duplicate"]},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 160},
        "correlation_id": {"type": "string", "format": "uuid"},
        "accepted_at": {"$ref": "#/$defs/utc_timestamp"}
      },
      "required": [
        "schema_version", "command_id", "command_type", "status", "idempotency_key",
        "correlation_id", "accepted_at"
      ]
    }
  },
  "oneOf": [{"$ref": "#/$defs/command"}, {"$ref": "#/$defs/receipt"}]
}
